# ---------------------------------------------------------------------------
# Copy to `.env` (repo root, for docker compose) and/or `apps/api/.env`
# (for running the API natively). All values below are safe local defaults.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development          # development | production
DEBUG=false

# Database
# Docker (Postgres):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_sales_qualifier
# Native, no Postgres needed (uncomment to run the API without Docker):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Redis
REDIS_URL=redis://redis:6379/0

# Security
PII_SALT=change-me-in-production
ENCRYPTION_KEY=            # Fernet key for encrypting stored API keys (optional)

# LLM / AI
LLM_PROVIDER=mock          # mock | openai  (mock needs no key and runs offline)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Pluggable providers
ENRICHMENT_PROVIDER=mock   # mock | clearbit
CRM_PROVIDER=mock          # mock | salesforce
EMAIL_PROVIDER=console     # console | smtp | sendgrid

# Notifications
SLACK_WEBHOOK_URL=
WEBHOOK_SECRET=

# Third-party API keys (only if the corresponding provider is enabled)
CLEARBIT_API_KEY=
APOLLO_API_KEY=

# Frontend (apps/web) — read by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
